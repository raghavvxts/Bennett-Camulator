TELEGRAM_BOT_TOKEN=
# Set to your numeric Telegram ID from /myid to enable owner-only /users.
OWNER_TELEGRAM_ID=
# Optional owner shortcut key; regular users get personal keys with /shortcut.
API_SECRET_KEY=
# Optional: credentials for the single-account shortcut API only.
PARENT_EMAIL=
PARENT_PASSWORD=
# Optional: defaults to the repository directory locally; set to a persistent mount when hosted.
# CAMULATOR_DATA_DIR=/var/data
# Optional Fernet key. If omitted, a private .credential.key is generated in the data directory.
# CREDENTIAL_KEY=
