# MyCamu Parent Credentials (Used to auto-approve passes & bypass SSO)
PARENT_EMAIL=your_parent_email@example.com
PARENT_PASSWORD=your_parent_password

# Secret Key to secure your 1-Tap iOS / Android HTTP Shortcut
API_SECRET_KEY=bennett-quick-pass-secret

# Telegram Bot Token (from @BotFather)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Your numeric Telegram User ID (from @userinfobot) so nobody else can trigger your bot
TELEGRAM_ALLOWED_USER_ID=123456789
